# ==============================================================================
# SENTINEL ENVIRONMENT CONFIGURATION TEMPLATE
# Competition Submission Reference (.env.example)
#
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
#
# NOTE: Never commit secrets, private tokens, or real user data to .env.
# SENTINEL operates 100% locally with zero cloud AI API dependencies.
# ==============================================================================

# Application Meta
APP_NAME=SENTINEL
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Database & Storage
DATABASE_URL=sqlite:///./sentinel.db
UPLOAD_DIR=./data/uploads

# Hardware Profile & Runtime Selection
# Target: "snapdragon_x_elite" | Host Fallback: "host_cpu"
TARGET_PROFILE=snapdragon_x_elite
# ONNX / PyTorch execution provider: "CPUExecutionProvider" | "QNNExecutionProvider"
RUNTIME_PROVIDER=CPUExecutionProvider
HOST_PLATFORM=Intel x86_64
NPU_VERIFIED=false

# Local AI Models (Hugging Face / ONNX Hub IDs)
VISION_MODEL=yolox_tiny.onnx
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPEECH_MODEL=openai/whisper-tiny
REASONING_MODEL_TARGET=Qwen/Qwen2.5-VL-3B-Instruct

# Runtime Modes
DEBUG_MODE=false
BENCHMARK_MODE=false
DEMO_MODE=false

# Privacy & Security Invariants
CAMERA_ENABLED=false
MICROPHONE_ENABLED=false
MEMORY_ENABLED=true
LOCAL_AI_MODE=local_only
CLOUD_FALLBACK=false
PRIVACY_STRICT=true
NO_CLOUD_GUARANTEE=true
ALLOW_RAW_AUDIO_PERSISTENCE=false
ALLOW_RAW_VIDEO_PERSISTENCE=false
